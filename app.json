{
  "expo": {
    "name": "Moji Dojo",
    "slug": "moji-dojo",
    "version": "1.13.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE3EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.edi.mojidojo",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 11300
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E7739A",
          "defaultChannel": "lembretes"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "O Moji Dojo usa o microfone para conferir a frase que você diz em japonês.",
          "speechRecognitionPermission": "O Moji Dojo usa o reconhecimento de fala para conferir a frase que você diz em japonês.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O Moji Dojo usa o microfone só para você gravar a sua voz e comparar com o modelo.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#FFF4F0",
          "dark": {
            "backgroundColor": "#12122B"
          }
        }
      ],
      "expo-status-bar",
      "expo-asset"
    ],
    "scheme": "mojidojo",
    "platforms": [
      "android"
    ]
  }
}
