<?xml version="1.0" encoding="utf-8"?>
<!-- Versão larga e baixa do widget: o número à esquerda e o texto à direita. Lançadores como o Niagara esticam o widget na largura da tela. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/mojiwidget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/mojiwidget_background"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingHorizontal="16dp"
  android:paddingVertical="8dp">

  <TextView
    android:id="@+id/mojiwidget_count"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="14dp"
    android:textColor="@color/mojiwidget_accent"
    android:textSize="34sp"
    android:textStyle="bold" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/mojiwidget_title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/mojiwidget_label"
      android:textColor="@color/mojiwidget_muted"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/mojiwidget_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/mojiwidget_text"
      android:textSize="14sp" />
  </LinearLayout>
</LinearLayout>
