<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 em diante: tamanho em células, pré-visualização com o layout de exemplo e redimensionamento livre (os lançadores que esticam o widget, como o Niagara, usam isto). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:minWidth="110dp"
  android:minHeight="55dp"
  android:minResizeWidth="110dp"
  android:minResizeHeight="55dp"
  android:targetCellWidth="2"
  android:targetCellHeight="1"
  android:updatePeriodMillis="1800000"
  android:initialLayout="@layout/mojiwidget_review"
  android:previewLayout="@layout/mojiwidget_preview"
  android:resizeMode="horizontal|vertical"
  android:widgetCategory="home_screen"
  android:description="@string/mojiwidget_description" />
